<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <SoftEtherSrcDir Condition="'$(SoftEtherSrcDir)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))</SoftEtherSrcDir>
    <SolutionDir Condition="'$(SolutionDir)' == '' or !Exists('$(SolutionDir)bin\BuildUtil.exe')">$(SoftEtherSrcDir)</SolutionDir>
  </PropertyGroup>

  <!-- WDK 10.0.26100.0 installs VS 17 task assemblies, but VS 18 requests 18.0 by default. -->
  <PropertyGroup Condition="'$(PlatformToolset)' == 'WindowsKernelModeDriver10.0' and '$(VisualStudioVersion)' == '18.0'">
    <VisualStudioVersion>17.0</VisualStudioVersion>
  </PropertyGroup>

  <!-- Kernel-mode signing now requires an explicit file digest algorithm. -->
  <ItemDefinitionGroup Condition="'$(ConfigurationType)' == 'Driver' and '$(PlatformToolset)' == 'WindowsKernelModeDriver10.0'">
    <DriverSign>
      <FileDigestAlgorithm Condition="'%(DriverSign.FileDigestAlgorithm)' == ''">sha256</FileDigestAlgorithm>
    </DriverSign>
  </ItemDefinitionGroup>

  <!-- Use one host-tool configuration and let MSBuild order it before native projects. -->
  <ItemGroup Condition="'$(PlatformToolset)' != 'WindowsKernelModeDriver10.0'">
    <ProjectReference Include="$(SoftEtherSrcDir)BuildUtil\BuildUtil.csproj">
      <Project>{384815C3-333C-4CEC-9DCD-B6AB2602EBB9}</Project>
      <SetConfiguration>Configuration=Release</SetConfiguration>
      <SetPlatform>Platform=AnyCPU</SetPlatform>
      <GlobalPropertiesToRemove>VisualStudioVersion</GlobalPropertiesToRemove>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!-- WDK treats ProjectReference items as driver-package inputs, including C# tools. -->
  <Target Name="BuildSoftEtherBuildUtil"
          BeforeTargets="PreLinkEvent"
          Condition="'$(PlatformToolset)' == 'WindowsKernelModeDriver10.0'">
    <MSBuild Projects="$(SoftEtherSrcDir)BuildUtil\BuildUtil.csproj"
             Targets="Build"
             Properties="Configuration=Release;Platform=AnyCPU"
             RemoveProperties="VisualStudioVersion" />
  </Target>
</Project>
